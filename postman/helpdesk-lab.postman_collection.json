                  "pm.test(\"Код стану 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Наявні заголовки ETag та Cache-Control\", () => {",
                  "  pm.expect(pm.response.headers.get(\"ETag\")).to.be.a(\"string\");",
