                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"a.petrenko@college.example.ua\",\n  \"password\": \"student123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код стану 200\", () => pm.response.to.have.status(200));",
                  "const login = pm.response.json();",
                  "pm.collectionVariables.set(\"studentToken\", login.accessToken);",
                  "pm.test(\"Отримано Bearer-токен здобувача\", () => {",
                  "  pm.expect(login.accessToken).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(login.tokenType).to.eql(\"Bearer\");",
                  "});",
                  "pm.test(\"Роль користувача – student\", () => {",
                  "  pm.expect(login.user.role).to.eql(\"student\");",
                  "});",
                  "pm.test(\"Заборонено кешування відповіді з токеном (no-store)\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
                  "});"
                ]
              }
            }
          ]
